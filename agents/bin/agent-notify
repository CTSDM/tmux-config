#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["jeepney>=0.9"]
# ///
# pyright: strict
"""Desktop notifications for agent panes.

    agent-notify <pane> <urgency> <title> <body>
        Show a notification (low, normal or critical), replacing the pane's
        previous one, and wait for it: clicking it jumps to the pane.
    agent-notify --close <pane>
        Close the pane's notification, e.g. once the pane has been seen.

This talks to org.freedesktop.Notifications directly because notify-send goes
through the desktop portal, which drops click actions. Run by uv; type-checked
with pyright (see README).
"""

import os
import signal
import subprocess
import sys
import time

from jeepney import DBusAddress, HeaderFields, MatchRule, Message, new_method_call
from jeepney.bus_messages import message_bus
from jeepney.io.blocking import DBusConnection, open_dbus_connection
from jeepney.wrappers import DBusErrorResponse, unwrap_msg

BIN = os.path.dirname(os.path.abspath(__file__))
NOTIFICATIONS = DBusAddress(
    "/org/freedesktop/Notifications",
    bus_name="org.freedesktop.Notifications",
    interface="org.freedesktop.Notifications",
)
URGENCY = {"low": 0, "normal": 1, "critical": 2}
WAIT_SECONDS = 6 * 3600


def tmux(*args: str) -> str:
    result = subprocess.run(["tmux", *args], capture_output=True, text=True)
    return result.stdout.strip()


def pane_opt(pane: str, name: str) -> str:
    return tmux("show", "-pqv", "-t", pane, name)


def forget(pane: str) -> None:
    tmux("set", "-pu", "-t", pane, "@agent_notify_id", ";",
         "set", "-pu", "-t", pane, "@agent_notify_pid")


def stop_waiter(pane: str) -> None:
    """Stop the process waiting on the pane's previous notification, so a
    click on the replacement is not handled twice. SIGTERM ends it at once,
    without the cleanup at the end of show()."""
    pid = pane_opt(pane, "@agent_notify_pid")
    if not pid.isdigit() or int(pid) == os.getpid():
        return
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"agent-notify" not in f.read():
                return
        os.kill(int(pid), signal.SIGTERM)
    except OSError:
        pass


def call(conn: DBusConnection, method: str, signature: str, body: tuple[object, ...]) -> tuple[object, ...]:
    reply = conn.send_and_get_reply(new_method_call(NOTIFICATIONS, method, signature, body), timeout=2)
    return unwrap_msg(reply)


def member(msg: Message) -> str:
    return str(msg.header.fields.get(HeaderFields.member, ""))


def close(pane: str) -> None:
    notification_id = pane_opt(pane, "@agent_notify_id")
    stop_waiter(pane)
    forget(pane)
    if notification_id.isdigit():
        with open_dbus_connection(bus="SESSION") as conn:
            call(conn, "CloseNotification", "u", (int(notification_id),))


def show(pane: str, urgency: str, title: str, body: str) -> None:
    previous = pane_opt(pane, "@agent_notify_id")
    stop_waiter(pane)
    with open_dbus_connection(bus="SESSION") as conn:
        # Listen before sending, so a quick click is not missed.
        rule = MatchRule(type="signal", interface=NOTIFICATIONS.interface,
                         path=NOTIFICATIONS.object_path)
        unwrap_msg(conn.send_and_get_reply(message_bus.AddMatch(rule), timeout=2))
        with conn.filter(rule) as signals:
            hints = {"urgency": ("y", URGENCY.get(urgency, 1))}
            (notification_id,) = call(conn, "Notify", "susssasa{sv}i", (
                "tmux agents", int(previous) if previous.isdigit() else 0,
                "utilities-terminal", title, body, ["default", "Open"], hints, -1))
            tmux("set", "-p", "-t", pane, "@agent_notify_id", str(notification_id), ";",
                 "set", "-p", "-t", pane, "@agent_notify_pid", str(os.getpid()))

            deadline = time.monotonic() + WAIT_SECONDS
            while (left := deadline - time.monotonic()) > 0:
                try:
                    msg = conn.recv_until_filtered(signals, timeout=left)
                except TimeoutError:
                    break
                if not msg.body or msg.body[0] != notification_id:
                    continue
                if member(msg) == "ActionInvoked" and msg.body[1] == "default":
                    subprocess.run([os.path.join(BIN, "agent-jump"), pane])
                    break
                if member(msg) == "NotificationClosed":
                    break
    if pane_opt(pane, "@agent_notify_pid") == str(os.getpid()):
        forget(pane)


def main(argv: list[str]) -> int:
    try:
        if len(argv) == 3 and argv[1] == "--close":
            close(argv[2])
        elif len(argv) == 5:
            show(argv[1], argv[2], argv[3], argv[4])
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except (OSError, KeyError, DBusErrorResponse):
        return 1  # no session bus or no notification daemon
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
