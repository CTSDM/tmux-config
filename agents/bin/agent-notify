#!/usr/bin/env python3
"""Desktop notifications for agent panes.

    agent-notify <pane> <urgency> <title> <body>
        Show a notification (low, normal or critical), replacing the pane's
        previous one, and wait for it: clicking it jumps to the pane.
    agent-notify --close <pane>
        Close the pane's notification, e.g. once the pane has been seen.

This talks to org.freedesktop.Notifications directly because notify-send goes
through the desktop portal, which drops click actions.
"""

import os
import signal
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

BIN = os.path.dirname(os.path.abspath(__file__))
URGENCY = {"low": 0, "normal": 1, "critical": 2}
BUS_NAME = "org.freedesktop.Notifications"
BUS_PATH = "/org/freedesktop/Notifications"


def tmux(*args):
    result = subprocess.run(["tmux", *args], capture_output=True, text=True)
    return result.stdout.strip()


def pane_opt(pane, name):
    return tmux("show", "-pqv", "-t", pane, name)


def forget(pane):
    tmux("set", "-pu", "-t", pane, "@agent_notify_id", ";",
         "set", "-pu", "-t", pane, "@agent_notify_pid")


def stop_waiter(pane):
    """Stop the process waiting on the pane's previous notification, so a
    click on the replacement is not handled twice."""
    pid = pane_opt(pane, "@agent_notify_pid")
    if not pid.isdigit() or int(pid) == os.getpid():
        return
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"agent-notify" not in f.read():
                return
        os.kill(int(pid), signal.SIGTERM)
    except OSError:
        pass


def proxy():
    return Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None,
        BUS_NAME, BUS_PATH, BUS_NAME, None)


def close(pane):
    notification_id = pane_opt(pane, "@agent_notify_id")
    stop_waiter(pane)
    forget(pane)
    if notification_id.isdigit():
        proxy().call_sync("CloseNotification",
                          GLib.Variant("(u)", (int(notification_id),)),
                          Gio.DBusCallFlags.NONE, 2000, None)


def show(pane, urgency, title, body):
    previous = pane_opt(pane, "@agent_notify_id")
    stop_waiter(pane)
    notifications = proxy()
    loop = GLib.MainLoop()
    state = {"id": None}

    def on_signal(_conn, _sender, _path, _iface, name, params, _data):
        if name == "ActionInvoked":
            notification_id, action = params.unpack()
            if notification_id == state["id"] and action == "default":
                subprocess.run([os.path.join(BIN, "agent-jump"), pane])
                loop.quit()
        elif name == "NotificationClosed":
            if params.unpack()[0] == state["id"]:
                loop.quit()

    # Subscribe before sending so a quick click is not missed.
    notifications.get_connection().signal_subscribe(
        None, BUS_NAME, None, BUS_PATH, None,
        Gio.DBusSignalFlags.NONE, on_signal, None)
    hints = {"urgency": GLib.Variant("y", URGENCY.get(urgency, 1))}
    reply = notifications.call_sync(
        "Notify",
        GLib.Variant("(susssasa{sv}i)", (
            "tmux agents", int(previous) if previous.isdigit() else 0,
            "utilities-terminal", title, body, ["default", "Open"], hints, -1)),
        Gio.DBusCallFlags.NONE, 2000, None)
    state["id"] = reply.unpack()[0]
    tmux("set", "-p", "-t", pane, "@agent_notify_id", str(state["id"]), ";",
         "set", "-p", "-t", pane, "@agent_notify_pid", str(os.getpid()))

    # A replacement notification stops this waiter with SIGTERM; Python's
    # default handling exits at once, without the cleanup below.
    GLib.timeout_add_seconds(6 * 3600, loop.quit)
    loop.run()
    if pane_opt(pane, "@agent_notify_pid") == str(os.getpid()):
        forget(pane)


def main(argv):
    try:
        if len(argv) == 3 and argv[1] == "--close":
            close(argv[2])
        elif len(argv) == 5:
            show(*argv[1:])
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except GLib.Error:
        return 1  # no notification daemon
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
