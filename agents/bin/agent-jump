#!/usr/bin/env bash
# agent-jump <pane> [client]: bring a pane in front of you.
#
# Selects the pane in its session. If that session is already open in a
# terminal window, focuses that window (Hyprland) instead of taking over the
# current one; otherwise shows the session in <client>, by default the most
# recently active client.
. "${BASH_SOURCE[0]%/*}/agent-lib.sh" || exit 1
pane=${1:?usage: agent-jump <pane> [client]} client=${2:-}

IFS=$US read -r sess win < <(tmux display -p -t "$pane" "#{session_name}$US#{window_id}") || exit 1
tmux select-window -t "$win" \; select-pane -t "$pane"

viewer=$(tmux list-clients -F "#{client_session}$US#{client_name}" |
  awk -F"$US" -v s="$sess" '$1 == s { print $2; exit }')
if [[ -n $viewer ]]; then
  [[ $viewer == "$client" ]] && exit 0
  ag_raise_client "$viewer" && exit 0
fi

if [[ -z $client ]]; then
  client=$(tmux list-clients -F "#{client_activity}$US#{client_name}$US#{client_session}" |
    awk -F"$US" '$3 !~ /^_peek-/' | sort -rn | head -n1 | cut -d"$US" -f2)
  [[ -n $client ]] || exit 1
  ag_raise_client "$client"
fi
tmux switch-client -c "$client" -t "$pane"
