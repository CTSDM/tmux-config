#!/usr/bin/env bash
# agent-new [client]: a small form to start a session, in a popup.
#
#   session name   empty: the folder's name; an existing session is just opened
#   host           with agentd: where its shell runs; `local` (the default, or
#                  @agent_new_host) or a server over ssh, whose shell is held
#                  there (agentd remote); Tab completes it from ~/.ssh/config
#   path           starts at the current pane's folder; Tab completes it, like
#                  in the shell; a missing folder can be created. On a server:
#                  its path, from ~, no completion
#
# The session joins the space spaces.conf names for its folder, or else the
# space you are in (not the "*" default). The last line says which before you
# confirm; then this terminal switches to the session.
# prefix+N runs `agent-new --popup <client>`, which opens it on that client.
. "${BASH_SOURCE[0]%/*}/agent-lib.sh" || exit 1

if [[ ${1:-} == --popup ]]; then
  exec tmux display-popup -c "$2" -E -w 74 -h 12 -T ' new session ' "'$AG_BIN/agent-new' '$2'"
fi
client=${1:-}

# Colors (Catppuccin Mocha). \001 and \002 tell readline where invisible
# characters are, so the cursor stays where it should.
E=$'\e' A=$'\001' B=$'\002'
RESET="$E[0m" DIM="$E[38;2;108;112;134m" TEXT="$E[38;2;205;214;244m" BOLD="$E[1m"
ACCENT="$E[38;2;203;166;247m" WARN="$E[38;2;250;179;135m" OK="$E[38;2;166;227;161m"
c() { printf '%s%s%s' "$A" "$1" "$B"; } # a color, marked invisible for readline
label() { printf '  %s%-12s %s›%s ' "$(c "$ACCENT$BOLD")" "$1" "$(c "$RESET$DIM")" "$(c "$RESET$TEXT")"; }
say() { printf '  %s\n' "$*"; }
short() { # a path shortened in the middle to fit the popup: ~/repos/…/project
  local p=${1/#$HOME/\~}
  ((${#p} <= 44)) && { printf '%s' "$p"; return; }
  local first last=${p##*/}
  first=${p%%/*}/$(cut -d/ -f2 <<<"$p")
  printf '%s/…/%s' "$first" "${last:0:30}"
}

IFS=$US read -r here space < <(ag_client "$client" "#{pane_current_path}$US#{?@space,#{@space},#{@space_auto}}")
here=${here:-$HOME}
agentd=$(tmux show -gqv @agentd)
default_host=$(tmux show -gqv @agent_new_host)
default_host=${default_host:-local}

# Hosts for Tab: local, the default, and ~/.ssh/config's (no patterns).
hosts() {
  {
    printf '%s\n' local "$default_host"
    awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' \
      "$HOME/.ssh/config" 2>/dev/null
  } | awk '!seen[$0]++'
}
# Tab on the host field: the first host that starts with what is typed
# (any case); Tab again, the next one.
complete_host() {
  local h
  if ((${#cycle[@]})) && [[ $READLINE_LINE == "${cycle[cycle_at]}" ]]; then
    cycle_at=$(((cycle_at + 1) % ${#cycle[@]}))
  else
    cycle=()
    cycle_at=0
    while IFS= read -r h; do
      [[ ${h,,} == "${READLINE_LINE,,}"* ]] && cycle+=("$h")
    done < <(hosts)
    ((${#cycle[@]})) || return 0
  fi
  READLINE_LINE=${cycle[cycle_at]}
  READLINE_POINT=${#READLINE_LINE}
}
cycle=() cycle_at=0
space_color() { case $1 in "") printf '%s' "$DIM" ;; *) printf '%s' "$ACCENT" ;; esac; }

export INPUTRC=$AG_BIN/../new-session.inputrc
trap 'printf "%s\n" "$RESET"; exit 0' INT

printf '\n'
say "${DIM}in $RESET$(space_color "$space")${space:-no space}$RESET$DIM · Tab completes · ctrl-c cancels$RESET"
printf '\n'

# Session name: tmux turns "." and ":" into "_" anyway.
read -r -e -p "$(label 'session name')" name || exit 0
name=${name//[.:]/_}
name=${name#"${name%%[![:space:]]*}"} name=${name%"${name##*[![:space:]]}"}
if [[ -n $name ]] && tmux has-session -t "=$name" 2>/dev/null; then
  printf '\n'
  say "${WARN}$name already exists$RESET${DIM}: enter opens it · any other key cancels$RESET"
  IFS= read -r -s -n1 key
  [[ -z $key ]] && tmux switch-client -c "$client" -t "=$name:"
  exit 0
fi

# Host: only with agentd, which holds the shell on the server.
host=local
if [[ -n $agentd ]]; then
  bind -x '"\t": complete_host' 2>/dev/null
  while :; do
    read -r -e -p "$(label 'host')" -i "$default_host" host || exit 0
    host=${host//[[:space:]]/}
    [[ -z $host || ${host,,} == local ]] && host=local
    # Never an ssh option (-oProxyCommand=... runs a command here); `-` is
    # this machine, held (agentd remote -).
    [[ $host == - || $host != -* ]] && break
    say "${WARN}$host is not a host$RESET"
  done
fi

if [[ $host == local ]]; then
  # Path, with Tab completion from readline; ~ is fine.
  bind '"\t": complete' 2>/dev/null
  while :; do
    read -r -e -p "$(label 'path')" -i "${here/#$HOME/\~}" path || exit 0
    path=${path/#\~/$HOME}
    [[ $path == / ]] || path=${path%/}
    [[ -n $path ]] || path=$HOME
    [[ -d $path ]] && break
    if [[ -e $path ]]; then
      say "${WARN}${path/#$HOME/\~} is a file, not a folder$RESET"
      continue
    fi
    say "${WARN}${path/#$HOME/\~} doesn't exist$RESET${DIM}: create it? y/N$RESET"
    IFS= read -r -s -n1 key
    if [[ $key == [yY] ]]; then mkdir -p -- "$path" && break; fi
  done
  path=$(realpath -- "$path")
  [[ -n $name ]] || name=$(basename -- "$path")
  # spaces.conf matches it.
  rule_path=$path
else
  # The server's path: nothing here can complete or check it; the shell
  # starts at home there if it isn't a folder.
  bind -x '"\t": :' 2>/dev/null
  read -r -e -p "$(label 'path')" -i '~' path || exit 0
  [[ $path == / ]] || path=${path%/}
  [[ -n $path ]] || path='~'
  if [[ -z $name ]]; then
    name=$(basename -- "$path")
    [[ $name == '~' || $name == / ]] && name=$host
  fi
  # spaces.conf's rules are this machine's folders: ~ is taken as ours.
  rule_path=${path/#\~/$HOME}
fi
name=${name//[.:]/_}

# Which space: the one spaces.conf names for the folder, else the current one.
read -r rule_space how < <("$AG_BIN/agent-spaces" which "$rule_path")
target=$space
[[ $how == named || -z $target ]] && target=$rule_space

printf '\n'
if tmux has-session -t "=$name" 2>/dev/null; then
  say "${WARN}$name already exists$RESET${DIM}: enter opens it · any other key cancels$RESET"
  IFS= read -r -s -n1 key
  [[ -z $key ]] && tmux switch-client -c "$client" -t "=$name:"
  exit 0
fi
note=""
[[ -n $target && -n $space && $target != "$space" ]] && note=" ${WARN}(its folder is in $target)$RESET"
if [[ $host == local ]]; then
  say "${OK}→$RESET $TEXT$BOLD$name$RESET$DIM in $(short "$path") · $RESET$(space_color "$target")${target:-no space}$RESET$note"
else
  # The name of the held shell: a file name part and a shell word there.
  hold=${name//[^A-Za-z0-9._-]/-}
  while [[ $hold == [-.]* ]]; do hold=${hold:1}; done
  hold=${hold:0:64}
  if [[ -z $hold ]]; then
    hold=${host//[^A-Za-z0-9._-]/-}
    while [[ $hold == [-.]* ]]; do hold=${hold:1}; done
    hold=${hold:-shell}
  fi
  say "${DIM}asking $host…$RESET"
  held=""
  if timeout 6 "$agentd" remote "$host" </dev/null 2>/dev/null | cut -f1 | grep -qxF -- "$hold"; then
    held=" ${WARN}(re-attaches to the $hold it holds)$RESET"
  fi
  printf '\e[1A\e[2K'
  say "${OK}→$RESET $TEXT$BOLD$name$RESET$DIM on $RESET$ACCENT$host$RESET$DIM in ${path} · $RESET$(space_color "$target")${target:-no space}$RESET$note$held"
fi
say "${DIM}enter creates it · any other key cancels$RESET"
IFS= read -r -s -n1 key
[[ -z $key ]] || exit 0

if [[ $host == local ]]; then
  tmux new-session -d -s "$name" -c "$path" || { sleep 2; exit 1; }
  # A folder only "*" matches follows the space you are in.
  [[ $how != named && -n $target ]] && tmux set -t "=$name:" @space "$target"
else
  # As arguments, not a shell command: nothing in them is read by a shell.
  tmux new-session -d -s "$name" -c "$HOME" "$agentd" remote "$host" "$hold" "$path" ||
    { sleep 2; exit 1; }
  # agentd remote refused it (or an old agentd has no `remote`): its pane is
  # gone at once, and without this the popup would just close.
  sleep 0.3
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    say "${WARN}the session ended at once: \`agentd remote $host $hold\` failed$RESET${DIM} · any key$RESET"
    IFS= read -r -s -n1 _
    exit 1
  fi
  # Its local folder is home, which says nothing of its space.
  [[ -n $target ]] && tmux set -t "=$name:" @space "$target"
fi
"$AG_BIN/agent-spaces" assign "$name"
tmux switch-client -c "$client" -t "=$name:"
